GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EVAL_MODEL=gpt-4.1
GEOJSON_INPUT=convert/sites.geojson
GEOJSON_OUTPUT=convert/sites.geojson
LLM_BATCH_LIMIT=10
GEMINI_CACHE_PATH=convert/llm_cache_gemini.json
GPT_CACHE_PATH=convert/llm_cache_gpt.json
LLM_REQUEST_DELAY_SECONDS=4.2
NO_LLM=0

# Optional cost estimates. Set to your current provider pricing per 1M tokens.
GEMINI_INPUT_COST_PER_1M=
GEMINI_OUTPUT_COST_PER_1M=
GPT_INPUT_COST_PER_1M=
GPT_OUTPUT_COST_PER_1M=
